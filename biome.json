{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*",
      "app/**/*",
      "components/**/*",
      "pages/**/*",
      "!node_modules",
      "!.next",
      "!out",
      "!public",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!yarn.lock"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noUnusedExpressions": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "info",
          "fix": "safe",
          "options": {
            "functions": ["clsx", "cva", "cn", "tw"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{js,jsx,mjs,ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaUnsupportedElements": "warn",
            "useAltText": "warn",
            "useAriaPropsForRole": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useValidAriaProps": "warn",
            "useValidAriaValues": "warn"
          },
          "correctness": {
            "noBeforeInteractiveScriptOutsideDocument": "warn",
            "noChildrenProp": "error",
            "noNextAsyncClientComponent": "warn",
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "error",
            "useInlineScriptId": "error",
            "useJsxKeyInIterable": "error"
          },
          "performance": {
            "noImgElement": "warn",
            "noSyncScripts": "warn",
            "noUnwantedPolyfillio": "warn",
            "useGoogleFontPreconnect": "warn"
          },
          "security": {
            "noDangerouslySetInnerHtmlWithChildren": "error"
          },
          "style": {
            "noHeadElement": "warn"
          },
          "suspicious": {
            "noCommentText": "error",
            "noDocumentImportInPage": "error",
            "noDuplicateJsxProps": "error",
            "noHeadImportInDocument": "error",
            "noUnknownAttribute": "off",
            "useGoogleFontDisplay": "warn"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
